  id: intro_room
  lines:
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: Sam? ...Bag's gone. Shoes are gone. You were supposed to be home an hour
      ago.
    background: {fileID: 0}
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: Okay. Don't panic. Mom and Dad are back at six. Think like a detective.
    background: {fileID: 0}
