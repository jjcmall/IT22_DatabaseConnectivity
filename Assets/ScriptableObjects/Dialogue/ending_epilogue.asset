  m_Script: {fileID: 11500000, guid: 2450fc7c3abd5554483716d545c4df34, type: 3}
  m_Name: ending_epilogue
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Dialogue.DialogueData
  id: ending_epilogue
  lines:
  - speaker: 
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 0}
    side: 0
    text: The streetlights flicker on as Alex and Sam walk home together.
    background: {fileID: 0}
  - speaker: Sam
    nameColor: {r: 0.95686275, g: 0.44705883, b: 0.7137255, a: 1}
    portrait: {fileID: 21300000, guid: 6d8ac1f038791554e8474d27bbaa71a8, type: 3}
    side: 1
    text: Next time I play Code Quest, will you play with me?
    background: {fileID: 0}
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: Deal. But next time, you tell someone where you're going first.
    background: {fileID: 0}
  - speaker: Sam
    nameColor: {r: 0.95686275, g: 0.44705883, b: 0.7137255, a: 1}
    portrait: {fileID: 21300000, guid: 6d8ac1f038791554e8474d27bbaa71a8, type: 3}
    side: 1
    text: Deal. ...You were really good at those {LANGUAGE} puzzles.
    background: {fileID: 0}
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: I just followed the clues.
    background: {fileID: 0}
