  - speaker: 
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 0}
    side: 0
    text: The wall of screens fades to black. For the first time in years, SENTINEL
      powers down.
    background: {fileID: 0}
