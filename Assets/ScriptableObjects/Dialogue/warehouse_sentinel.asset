  lines:
  - speaker: SENTINEL
    nameColor: {r: 0.654902, g: 0.54509807, b: 0.98039216, a: 1}
    portrait: {fileID: 21300000, guid: 99ffee20feeb641409c012c0e07dfdf5, type: 3}
    side: 1
    text: CHECKPOINT 2. VISITOR PASSED THIS POINT 41 MINUTES AGO. NEXT LOCK REQUIRES
      {LANGUAGE}.
    background: {fileID: 0}
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: Another code lock. The clues keep going - Sam really is following a trail.
    background: {fileID: 0}
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: Okay, SENTINEL, or whoever you are. Let's see what you've got.
    background: {fileID: 0}
