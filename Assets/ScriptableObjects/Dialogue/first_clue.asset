  m_Name: first_clue
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Dialogue.DialogueData
  id: first_clue
  lines:
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: '"Follow the code"? Somebody planned all of this. Somebody knew I''d come
      looking.'
    background: {fileID: 0}
  - speaker: Alex
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 21300000, guid: 413a18e5accaf4940bfb67e65babd266, type: 3}
    side: 0
    text: Fine. If code is the trail, I'll follow it all the way to you, Sam.
    background: {fileID: 0}
  - speaker: 
    nameColor: {r: 0.13333334, g: 0.827451, b: 0.93333334, a: 1}
    portrait: {fileID: 0}
    side: 0
    text: With a soft click, the hallway door slides open. The family computer hums
      on the other side.
    background: {fileID: 0}
