  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: SQL_03_ORDER_BY
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: SQL_03_ORDER_BY
  language: 3
  topic: ORDER BY
  difficulty: 1
  questionType: 1
  questionText: Which location is returned FIRST?
  code: 'Table: sightings

    +----+----------+-------+---------+

    | id | location
    | time  | witness |

    +----+----------+-------+---------+

    |  1 | Park    
    | 15:10 | Mia     |

    |  2 | Library  | 15:40 | Leo     |

    |  3 | Bus
    Stop | 16:05 | Ana     |

    |  4 | Arcade   | 15:25 | Leo     |

    +----+----------+-------+---------+


    SELECT
    location FROM sightings

    ORDER BY time DESC;'
  answerFormat: 0
  choices:
  - Bus Stop
  - Park
  - Library
  - Arcade
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers: []
  caseSensitive: 1
  explanation: DESC sorts from the highest value to the lowest, so the latest time
    (16:05, Bus Stop) comes first. ASC, the default, would start with Park at 15:10.
  hint: 'DESC means descending: the biggest (latest) value comes first.'
