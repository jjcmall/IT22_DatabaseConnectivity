  m_Name: SQL_09_GROUP_BY
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: SQL_09_GROUP_BY
  language: 3
  topic: GROUP BY
  difficulty: 1
  questionType: 2
  questionText: Which clause fills the blank to count the sightings for each witness?
  code: 'Table: sightings

    +----+----------+-------+---------+

    | id | location
    | time  | witness |

    +----+----------+-------+---------+

    |  1 | Park    
    | 15:10 | Mia     |

    |  2 | Library  | 15:40 | Leo     |

    |  3 | Bus
    Stop | 16:05 | Ana     |

    |  4 | Arcade   | 15:25 | Leo     |

    +----+----------+-------+---------+


    SELECT
    witness, COUNT(*)

    FROM sightings

    ___ witness;'
  answerFormat: 0
  choices:
  - GROUP BY
  - ORDER BY
  - WHERE
  - COUNT BY
  correctChoiceIndex: 0
  monospaceChoices: 1
  acceptedAnswers: []
  caseSensitive: 1
  explanation: 'GROUP BY witness puts rows with the same witness together, so COUNT(*)
    is worked out per witness: Mia 1, Leo 2, Ana 1. COUNT BY does not exist in SQL.'
  hint: You want one result row per witness.
