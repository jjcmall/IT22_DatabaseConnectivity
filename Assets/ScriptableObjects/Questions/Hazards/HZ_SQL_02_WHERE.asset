  id: HZ_SQL_02_WHERE
  language: 3
  topic: WHERE
  difficulty: 0
  questionType: 1
  questionText: Which names does this query return?
  code: 'Table: badges

    +----+-------+------------+-------+

    | id | name 
    | department | level |

    +----+-------+------------+-------+

    |  1 | Rosa 
    | Security   |     3 |

    |  2 | Omar  | Lab        |     1 |

    |  3 | Kim  
    | Security   |     2 |

    |  4 | Tariq | Archive    |     1 |

    +----+-------+------------+-------+


    SELECT
    name FROM badges

    WHERE department = ''Security'';'
  answerFormat: 0
  choices:
  - Rosa and Kim
  - Omar and Tariq
  - Rosa only
  - All four names
  correctChoiceIndex: 0
  monospaceChoices: 1
  acceptedAnswers: []
  caseSensitive: 1
  explanation: 'WHERE keeps only the rows whose department is Security: Rosa (row
    1) and Kim (row 3).'
  hint: Look down the department column for Security.
