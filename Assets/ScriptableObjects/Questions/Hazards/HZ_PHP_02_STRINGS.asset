  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: HZ_PHP_02_STRINGS
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: HZ_PHP_02_STRINGS
  language: 2
  topic: Strings
  difficulty: 0
  questionType: 1
  questionText: What message appears on the security screen?
  code: '<?php

    $name = "Sam";

    echo "Find " . $name . "!";

    ?>'
  answerFormat: 0
  choices:
  - Find Sam!
  - Find . Sam . !
  - Find $name!
  - FindSam!
  correctChoiceIndex: 0
  monospaceChoices: 1
  acceptedAnswers: []
  caseSensitive: 1
  explanation: The dot (.) joins strings. "Find " . "Sam" . "!" becomes Find Sam!
    - the space was already inside "Find ".
  hint: The . operator glues the pieces together exactly as they are.
