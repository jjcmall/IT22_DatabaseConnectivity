  m_Name: HZ_SQL_06_GROUP_BY
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: HZ_SQL_06_GROUP_BY
  language: 3
  topic: GROUP BY
  difficulty: 1
  questionType: 1
  questionText: How many rows does this query return?
  code: 'Table: badges

    +----+-------+------------+-------+

    | id | name 
    | department | level |

    +----+-------+------------+-------+

    |  1 | Rosa 
    | Security   |     3 |

    |  2 | Omar  | Lab        |     1 |

    |  3 | Kim  
    | Security   |     2 |

    |  4 | Tariq | Archive    |     1 |

    +----+-------+------------+-------+


    SELECT
    department, COUNT(*) FROM badges

    GROUP BY department;'
  answerFormat: 0
  choices:
  - 1
  - 2
  - 3
  - 4
  correctChoiceIndex: 2
  monospaceChoices: 1
  acceptedAnswers: []
  caseSensitive: 1
  explanation: 'GROUP BY makes one row per department: Security (2), Lab (1) and
    Archive (1). That is 3 rows.'
  hint: How many different departments are there?
