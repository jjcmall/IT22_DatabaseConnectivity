  m_Name: HZ_SQL_04_ORDER_BY
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: HZ_SQL_04_ORDER_BY
  language: 3
  topic: ORDER BY
  difficulty: 1
  questionType: 1
  questionText: Which name comes first in the result?
  code: 'Table: badges

    +----+-------+------------+-------+

    | id | name 
    | department | level |

    +----+-------+------------+-------+

    |  1 | Rosa 
    | Security   |     3 |

    |  2 | Omar  | Lab        |     1 |

    |  3 | Kim  
    | Security   |     2 |

    |  4 | Tariq | Archive    |     1 |

    +----+-------+------------+-------+


    SELECT
    name FROM badges

    ORDER BY level DESC;'
  answerFormat: 0
  choices:
  - Rosa
  - Omar
  - Kim
  - Tariq
  correctChoiceIndex: 0
  monospaceChoices: 1
  acceptedAnswers: []
  caseSensitive: 1
  explanation: DESC sorts from the highest value to the lowest. Rosa has the highest
    level (3), so she comes first.
  hint: DESC means highest first.
