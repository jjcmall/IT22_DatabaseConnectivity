  id: PY_01_VARIABLES
  language: 1
  topic: Variables
  difficulty: 0
  questionType: 1
  questionText: What does this code print?
  code: 'name = "Sam"

    name = "Alex"

    print(name)'
  answerFormat: 0
  choices:
  - Sam
  - Alex
  - name
  - Sam Alex
