  m_Name: PHP_06_BOOLEAN
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PHP_06_BOOLEAN
  language: 2
  topic: Boolean Logic
  difficulty: 1
  questionType: 0
  questionText: What is the value of $safe?
  code: '<?php

    $hasMap = true;

    $isDark = true;

    $safe = $hasMap ||
    !$isDark;

    ?>'
  answerFormat: 0
  choices:
  - true
  - false
  - null
  - It causes an error
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers: []
  caseSensitive: 1
  explanation: '|| means OR: the result is true if at least one side is true. $hasMap
    is true, so $safe is true, even though !$isDark is false.'
  hint: With OR (||), how many sides need to be true?
