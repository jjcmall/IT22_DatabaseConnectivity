  m_Name: PHP_09_ARRAYS
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PHP_09_ARRAYS
  language: 2
  topic: Arrays
  difficulty: 0
  questionType: 4
  questionText: Which line correctly creates an array of three places?
  code: 
  answerFormat: 0
  choices:
  - $places = ["park", "library", "arcade"];
  - $places = "park", "library", "arcade";
  - $places = {"park", "library", "arcade"};
  - places = ["park", "library", "arcade"];
  correctChoiceIndex: 0
  monospaceChoices: 1
  acceptedAnswers: []
  caseSensitive: 1
  explanation: PHP arrays are written with square brackets [ ] (or array(...)). Option
    B is not an array, curly braces { } don't create arrays, and option D is missing
    the $ in front of the variable name.
  hint: Arrays use square brackets, and variables always need a $.
